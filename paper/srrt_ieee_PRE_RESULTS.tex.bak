\small
\begin{tabular}{@{}llcccc@{}}
\toprule
& Configuration & Ep. & PSNR (dB) & SSIM & LPIPS \\
\midrule
A & Restormer        & 57 & 28.937 & 0.8661 & 0.1356 \\
B & + SeeCoder       & \multicolumn{4}{c}{\emph{inadmissible: 41/60 epochs}} \\
C & + DiffAE         & 59 & 28.936 & 0.8668 & 0.1358 \\
D & + LCR            & 59 & \textbf{29.014} & \textbf{0.8683} & \textbf{0.1322} \\
E & + Rectified Flow & \multicolumn{4}{c}{\emph{inadmissible: diverged, best ep.\ 5}} \\
